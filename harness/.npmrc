# Block install-time lifecycle scripts (preinstall/install/postinstall) from
# every dependency, including transitive ones. This harness pulls in
# @deepseek-ai/* packages we don't control; disabling scripts is a supply-chain
# guard against a compromised/malicious package running arbitrary code during
# `pnpm install`. If a real dependency ever needs a build script, allow it
# explicitly via pnpm's `onlyBuiltDependencies` rather than flipping this off.
ignore-scripts=true

# Fail the install instead of silently continuing when the running Node
# version doesn't satisfy package.json's "engines.node" (>=22.15.0, see
# .nvmrc). Without this, pnpm just warns, and a wrong Node version can
# produce subtle runtime failures in this ESM/tsx-based harness that are much
# harder to diagnose than an install-time error.
engine-strict=true
